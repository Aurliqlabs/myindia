{
  "name": "@republic543/core",
  "version": "0.5.0",
  "private": true,
  "description": "Simulation and content core for REPUBLIC: 543",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build:core": "tsc -p tsconfig.core.json && node scripts/copy-shared.cjs",
    "build:engine": "npm run build:core && node scripts/bundle-engine.cjs",
    "check:engine": "npm run build:core && node scripts/bundle-engine.cjs --check",
    "validate:data": "node scripts/validate-reality-data.cjs",
    "test:people": "node scripts/people-test.cjs",
    "test:core": "npm run build:core && node scripts/smoke-test.cjs && npm run test:people && npm run validate:data",
    "test:browser": "node scripts/test-browser.cjs",
    "sim:balance": "node scripts/balance-sim.cjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
